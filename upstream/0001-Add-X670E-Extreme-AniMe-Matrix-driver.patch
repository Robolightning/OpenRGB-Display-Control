+
+class AsusAnimeMatrixController
+{
+public:
+    AsusAnimeMatrixController(hid_device* device, const char* path, const char* firmware);
+    ~AsusAnimeMatrixController();
+
+    bool                        SetMode(unsigned char value);
+    bool                        SendFrame(const unsigned char* frame, size_t size);
+    int                         GetMode();
+    std::string                 GetLocation();
+    std::string                 GetSerial();
+    std::string                 GetFirmware();
+
+private:
+    static std::shared_ptr<libusb_context> SharedUSBContext();
+    bool                        Command(const unsigned char* data, size_t size, unsigned char reply);
+    bool                        ReadMode();
+    bool                        SetModeLocked(unsigned char value);
+    bool                        OpenBulk();
+    void                        CloseBulk();
+
+    hid_device*                 hid;
+    std::shared_ptr<libusb_context> usb_context;
+    libusb_device_handle*       bulk;
+    std::mutex                  io_mutex;
+    std::string                 location;
+    std::string                 serial;
+    std::string                 firmware;
+    unsigned char               last_frame[ASUS_MATRIX_FRAME_SIZE];
+    bool                        frame_valid;
+    int                         hardware_mode;
+};
