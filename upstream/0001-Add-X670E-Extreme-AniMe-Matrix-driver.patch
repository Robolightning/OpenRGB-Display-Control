diff --git a/Controllers/AsusAnimeMatrixController/AsusAnimeMatrixController.cpp b/Controllers/AsusAnimeMatrixController/AsusAnimeMatrixController.cpp
new file mode 100644
index 0000000..026acd1
--- /dev/null
+++ b/Controllers/AsusAnimeMatrixController/AsusAnimeMatrixController.cpp
@@ -0,0 +1,266 @@
+/*---------------------------------------------------------*\
+| AsusAnimeMatrixController.cpp                            |
+|                                                         |
+|   USB transport for X670E Extreme AniMe Matrix           |
+|                                                         |
+|   Robolightning                             18 Nov 2026 |
+|                                                         |
+|   SPDX-License-Identifier: GPL-2.0-or-later               |
+\*---------------------------------------------------------*/
+
+#include "AsusAnimeMatrixController.h"
+#include "LogManager.h"
+#include "StringUtils.h"
+#include <chrono>
+#include <cstring>
+
+std::shared_ptr<libusb_context> AsusAnimeMatrixController::SharedUSBContext()
+{
+    /*-----------------------------------------------------*\
+    | Create before generic detection selects UsbDk as the  |
+    | global default. Instances retain context ownership   |
+    | across rescans and through static destruction.       |
+    \*-----------------------------------------------------*/
+    static std::shared_ptr<libusb_context> context;
+    static std::mutex context_mutex;
+    std::lock_guard<std::mutex> guard(context_mutex);
+    if(!context)
+    {
+        libusb_context* value = nullptr;
+        int result = libusb_init(&value);
+        if(result != 0)
+        {
+            LOG_WARNING("[ASUS AniMe Matrix] USB context initialization: %s", libusb_error_name(result));
+        }
+        else
+        {
+            context = std::shared_ptr<libusb_context>(value, libusb_exit);
+        }
+    }
+    return context;
+}
+
+AsusAnimeMatrixController::AsusAnimeMatrixController(hid_device* device, const char* path, const char* firmware_string)
+    : hid(device), usb_context(SharedUSBContext()), bulk(nullptr),
+      location(std::string("HID: ") + path), firmware(firmware_string),
+      frame_valid(false), hardware_mode(-1)
+{
+    wchar_t number[256] = {};
+    if(hid_get_serial_number_string(hid, number, 256) == 0)
+    {
+        serial = StringUtils::wchar_to_string(number);
+    }
+    ReadMode();
+}
+
+AsusAnimeMatrixController::~AsusAnimeMatrixController()
+{
+    CloseBulk();
+    hid_close(hid);
+}
+
+bool AsusAnimeMatrixController::Command(const unsigned char* data, size_t size, unsigned char reply)
+{
+    if(size < 2 || size > 65)
+    {
+        return false;
+    }
+    unsigned char packet[65] = {};
+    std::memcpy(packet, data, size);
+    int written = hid_write(hid, packet, sizeof(packet));
+    if(written != sizeof(packet))
+    {
+        LOG_WARNING("[ASUS AniMe Matrix] HID command %02X write: %d/65", data[1], written);
+        return false;
+    }
+    std::chrono::steady_clock::time_point deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(300);
+    while(std::chrono::steady_clock::now() < deadline)
+    {
+        int count = hid_read_timeout(hid, packet, sizeof(packet), 20);
+        if(count < 0)
+        {
+            break;
+        }
+        if(count >= 3 && packet[0] == 0xEC && packet[1] == reply)
+        {
+            if(reply == 0x41)
+            {
+                if(count <= 10 || packet[10] > 2)
+                {
+                    break;
+                }
+                hardware_mode = packet[10];
+                return true;
+            }
+            if(packet[2] == 0)
+            {
+                return true;
+            }
+            break;
+        }
+    }
+    LOG_WARNING("[ASUS AniMe Matrix] Missing/invalid reply for command %02X", data[1]);
+    return false;
+}
+
+bool AsusAnimeMatrixController::ReadMode()
+{
+    const unsigned char query[] = {0xEC, 0xC1};
+    return Command(query, sizeof(query), 0x41);
+}
+
+bool AsusAnimeMatrixController::SetModeLocked(unsigned char value)
+{
+    if(value > 2)
+    {
+        return false;
+    }
+    const unsigned char command[] = {0xEC, 0x42, value, 0, 0};
+    frame_valid = false;
+    if(!Command(command, sizeof(command), 0x42))
+    {
+        hardware_mode = -1;
+        return false;
+    }
+    hardware_mode = value;
+    if(value == 0 && (!ReadMode() || hardware_mode != 0))
+    {
+        LOG_WARNING("[ASUS AniMe Matrix] Off-mode readback failed");
+        hardware_mode = -1;
+        return false;
+    }
+    return true;
+}
+
+bool AsusAnimeMatrixController::SetMode(unsigned char value)
+{
+    std::lock_guard<std::mutex> guard(io_mutex);
+    bool applied = SetModeLocked(value);
+    if(value != 1)
+    {
+        CloseBulk();
+    }
+    return applied;
+}
+
+bool AsusAnimeMatrixController::OpenBulk()
+{
+    if(bulk)
+    {
+        return true;
+    }
+    if(!usb_context || serial.empty())
+    {
+        LOG_WARNING("[ASUS AniMe Matrix] Cannot open bulk interface without USB context and serial identity");
+        return false;
+    }
+    libusb_device** devices = nullptr;
+    ssize_t count = libusb_get_device_list(usb_context.get(), &devices);
+    if(count < 0)
+    {
+        LOG_WARNING("[ASUS AniMe Matrix] USB enumeration failed: %s", libusb_error_name((int)count));
+        return false;
+    }
+    for(ssize_t i = 0; i < count && !bulk; i++)
+    {
+        libusb_device_descriptor desc;
+        if(libusb_get_device_descriptor(devices[i], &desc) != 0 || desc.idVendor != 0x0B05 || desc.idProduct != 0x1A21)
+        {
+            continue;
+        }
+        libusb_device_handle* candidate = nullptr;
+        int result = libusb_open(devices[i], &candidate);
+        if(result != 0)
+        {
+            LOG_WARNING("[ASUS AniMe Matrix] USB open: %s", libusb_error_name(result));
+            continue;
+        }
+        unsigned char number[256] = {};
+        int length = libusb_get_string_descriptor_ascii(candidate, desc.iSerialNumber, number, sizeof(number) - 1);
+        if(length > 0 && serial == (const char*)number)
+        {
+            result = libusb_claim_interface(candidate, 0);
+            if(result == 0)
+            {
+                bulk = candidate;
+                break;
+            }
+            LOG_WARNING("[ASUS AniMe Matrix] USB interface claim: %s", libusb_error_name(result));
+        }
+        libusb_close(candidate);
+    }
+    libusb_free_device_list(devices, 1);
+    return bulk != nullptr;
+}
+
+void AsusAnimeMatrixController::CloseBulk()
+{
+    if(bulk)
+    {
+        libusb_release_interface(bulk, 0);
+        libusb_close(bulk);
+        bulk = nullptr;
+    }
+    frame_valid = false;
+}
+
+bool AsusAnimeMatrixController::SendFrame(const unsigned char* frame, size_t size)
+{
+    if(!frame || size != ASUS_MATRIX_FRAME_SIZE)
+    {
+        return false;
+    }
+    std::lock_guard<std::mutex> guard(io_mutex);
+    if(frame_valid && hardware_mode == 1 && std::memcmp(frame, last_frame, size) == 0)
+    {
+        return true;
+    }
+    if(!OpenBulk())
+    {
+        return false;
+    }
+    if(hardware_mode != 1 && !SetModeLocked(1))
+    {
+        CloseBulk();
+        return false;
+    }
+    const unsigned char prep[] = {0xEC, 0x7F, 4, 0, 3};
+    if(!Command(prep, sizeof(prep), 0x7F))
+    {
+        CloseBulk();
+        return false;
+    }
+    int written = 0;
+    int result = libusb_bulk_transfer(bulk, 0x01, (unsigned char*)frame, ASUS_MATRIX_FRAME_SIZE, &written, 500);
+    if(result != 0 || written != ASUS_MATRIX_FRAME_SIZE)
+    {
+        LOG_WARNING("[ASUS AniMe Matrix] Bulk frame failed: %s, %d/768 bytes", libusb_error_name(result), written);
+        hardware_mode = -1;
+        CloseBulk();
+        return false;
+    }
+    std::memcpy(last_frame, frame, size);
+    frame_valid = true;
+    return true;
+}
+
+int AsusAnimeMatrixController::GetMode()
+{
+    std::lock_guard<std::mutex> guard(io_mutex);
+    return hardware_mode;
+}
+
+std::string AsusAnimeMatrixController::GetLocation()
+{
+    return location;
+}
+
+std::string AsusAnimeMatrixController::GetSerial()
+{
+    return serial;
+}
+
+std::string AsusAnimeMatrixController::GetFirmware()
+{
+    return firmware;
+}
