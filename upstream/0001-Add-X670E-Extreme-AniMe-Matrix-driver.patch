@@ -0,0 +1,48 @@
+/*---------------------------------------------------------*\
+| AsusAnimeMatrixControllerDetect.cpp                      |
+|                                                         |
+|   Detect the X670E Extreme AniMe Matrix HID interface    |
+|                                                         |
+|   Robolightning                             18 Nov 2026 |
+|                                                         |
+|   SPDX-License-Identifier: GPL-2.0-or-later               |
+\*---------------------------------------------------------*/
+
+#include "DetectionManager.h"
+#include "LogManager.h"
+#include "RGBController_AsusAnimeMatrix.h"
+#include <cstring>
+
+DetectedControllers DetectAsusAnimeMatrix(hid_device_info* info, const std::string&)
+{
+    DetectedControllers result;
+    hid_device* device = hid_open_path(info->path);
+    if(!device)
+    {
+        return result;
+    }
+    unsigned char packet[65] = {0xEC, 0x82};
+    if(hid_write(device, packet, sizeof(packet)) == sizeof(packet))
+    {
+        for(int i = 0; i < 8; i++)
+        {
+            int count = hid_read_timeout(device, packet, sizeof(packet), 50);
+            if(count < 0)
+            {
+                break;
+            }
+            if(count >= 14 && packet[0] == 0xEC && packet[1] == 0x02 && std::memcmp(packet + 3, "ALDR2-S452-", 11) == 0)
+            {
+                packet[count < 65 ? count : 64] = 0;
+                AsusAnimeMatrixController* controller = new AsusAnimeMatrixController(device, info->path, (const char*)packet + 3);
+                result.push_back(new RGBController_AsusAnimeMatrix(controller));
+                LOG_INFO("[ASUS AniMe Matrix] Detected X670E Extreme, firmware %s", packet + 3);
+                return result;
+            }
+        }
+    }
+    hid_close(device);
+    return result;
+}
+
+REGISTER_HID_DETECTOR_I("ASUS ROG Crosshair X670E Extreme AniMe Matrix", DetectAsusAnimeMatrix, 0x0B05, 0x1A21, 1);
diff --git a/Controllers/AsusAnimeMatrixController/AsusAnimeMatrixMap.h b/Controllers/AsusAnimeMatrixController/AsusAnimeMatrixMap.h
